# Caddy: use o dominio depois de apontar o DNS para o IP da VM.
# Sem dominio, use http://IP_PUBLICO para a primeira validacao.
SITE_ADDRESS=https://painel.example.com
# Gere com: docker run --rm caddy:2-alpine caddy hash-password --plaintext SUA-SENHA
ADMIN_PASSWORD_HASH=
# Gere uma string aleatoria com pelo menos 32 caracteres e mantenha somente no servidor.
ADMIN_SESSION_SECRET=

NODE_ENV=production
PORT=3001
PUBLIC_DIR=/app/public
TZ=America/Sao_Paulo
CORS_ORIGIN=https://painel.example.com

# Persistencia operacional. Use a secret key apenas neste arquivo do servidor.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA
SUPABASE_SCHEMA=public

ALOCACAO_HUB_CHAT_ID=120363420668199320@g.us
COP_REDE_EMPRESARIAL_CHAT_ID=120363423786613991@g.us

# Estado esperado da primeira fase: o app sobe degradado, sem atualizacao do HUB/WhatsApp.
EVOLUTION_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_SOURCE_CHAT_ID=
WHATSAPP_POLLING_DISABLED=true
WHATSAPP_POLLING_INTERVAL=30000

# MONITOR DE GERENCIA. Ambos vazios = impossivel habilitar. Nunca coloque senhas em Git.
# Solicite o ID real do grupo antes de habilitar em producao.
GERENCIA_GROUP_CHAT_ID=5521993571609-1390687807@g.us
# Gere um hash bcrypt com custo >= 12 e salve aqui (em compose .env, dobre cada $ do hash).
# Esta senha e DIFERENTE da senha ADMIN_PASSWORD_HASH compartilhada com supervisores.
GERENCIA_CONTROL_PASSWORD_HASH=
# Token aleatorio de pelo menos 32 caracteres; configure o mesmo no header
# X-Gerencia-Webhook-Token do webhook POR INSTANCIA da Evolution.
GERENCIA_WEBHOOK_TOKEN=

VISIUM_BASE_URL=http://201.55.234.76/Consultas_/ConsultaInterfaceNode
VISIUM_TIMEOUT_MS=25000
